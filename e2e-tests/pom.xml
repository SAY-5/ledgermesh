<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.ledgermesh</groupId>
    <artifactId>ledgermesh</artifactId>
    <version>4.0.0</version>
  </parent>

  <artifactId>e2e-tests</artifactId>
  <name>e2e-tests</name>
  <description>Runs the three services in one JVM against Redpanda, Redis and Postgres containers</description>

  <dependencies>
    <dependency>
      <groupId>io.ledgermesh</groupId>
      <artifactId>order-service</artifactId>
    </dependency>
    <dependency>
      <groupId>io.ledgermesh</groupId>
      <artifactId>inventory-service</artifactId>
    </dependency>
    <dependency>
      <groupId>io.ledgermesh</groupId>
      <artifactId>payment-service</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-redpanda</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-postgresql</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.awaitility</groupId>
      <artifactId>awaitility</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <configuration>
          <skipIfEmpty>true</skipIfEmpty>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
