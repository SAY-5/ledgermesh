{
  "name": "ledgermesh-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "selfcheck": "esbuild src/sim/selfcheck.ts --bundle --platform=node --format=esm --log-level=warning --outfile=node_modules/.cache/selfcheck.mjs && node node_modules/.cache/selfcheck.mjs",
    "config": "node scripts/extract-config.mjs",
    "config:check": "node scripts/extract-config.mjs --check"
  },
  "dependencies": {
    "framer-motion": "^11.11.17",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "5.2.0",
    "esbuild": "0.28.2",
    "typescript": "^5.6.3",
    "vite": "7.3.6"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
